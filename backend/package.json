{
  "name": "backend",
  "version": "0.0.1",
  "description": "API do Squad SEMISPE (NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:spaces:service": "ts-node test/spaces-service.smoke.ts",
    "test:spaces:http": "ts-node test/spaces-http.smoke.ts",
    "test:reservations:mysql": "ts-node test/reservations-mysql.smoke.ts",
    "test:reservations:docker": "node test/reservations-docker.smoke.cjs",
    "test:contacts:mysql": "ts-node test/contacts-mysql.smoke.ts",
    "test:contacts:docker": "node test/contacts-docker.smoke.cjs",
    "test:ecosystem:mysql": "ts-node test/ecosystem-mysql.smoke.ts",
    "test:ecosystem:docker": "node test/ecosystem-docker.smoke.cjs",
    "test:news:mysql": "ts-node test/news-mysql.smoke.ts",
    "test:news:docker": "node test/news-docker.smoke.cjs",
    "test:integrity:mysql": "ts-node test/integrity-mysql.smoke.ts",
    "test:integrity:docker": "node test/integrity-docker.smoke.cjs",
    "dev:spaces-admin": "ts-node test/create-spaces-admin.ts",
    "test:ideas:http": "ts-node test/ideas-http.smoke.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "dev:spaces-catalog": "ts-node test/create-spaces-catalog.ts",
    "stations:export": "ts-node test/export-stations.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "smtp-server": "^3.21.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "typeorm": { "glob": "14.0.2" },
    "@nestjs/cli": { "glob": "14.0.2" },
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.1" },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
